{
  "packages": {
    ".": {
      "release-type": "rust",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "editors/vscode/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "editors/vscode/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "editors/vscode/package-lock.json",
          "jsonpath": "$.packages['']['version']"
        }
      ]
    }
  }
}
